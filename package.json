{
  "name": "lastgenie",
  "version": "1.0.0",
  "private": true,
  "description": "Ecommerce website for Genie sexual enhancer drinks",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev": "echo 'Please run dev:client or dev:server. For both, use separate terminals.'",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "db:studio": "cd server && npm run db:studio",
    "db:studio:kill": "cd server && npm run db:studio:kill",
    "db:studio:alt": "cd server && npm run db:studio:alt",
    "db:generate": "cd server && npm run db:generate",
    "db:push": "cd server && npm run db:push",
    "db:migrate": "cd server && npm run db:migrate",
    "install:all": "cd client && npm install && cd ../server && npm install"
  }
}
