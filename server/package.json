{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio --port ${PRISMA_STUDIO_PORT:-5555}",
    "db:studio:kill": "lsof -ti:5555 | xargs kill -9 2>/dev/null || true",
    "db:studio:alt": "prisma studio --port 5556",
    "verify:address-validation": "node scripts/verify-address-validation-config.js",
    "test:address-validation": "node scripts/test-address-validation.js",
    "promote-admin": "ts-node scripts/promote-admin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
