# ============================================
# AUTHENTICATION (JWT Tokens)
# ============================================
# Required for login/signup functionality
# Generate secure random strings using: openssl rand -base64 32
# These keys should be unique for each environment (dev, staging, production)
JWT_SECRET="Fc1zan5CNB1UJC/XS4jed0dBDQlBwXuYqzd9xz9DlEM="
JWT_REFRESH_SECRET="tdpjqLjLyjCwgoMUQmqjB3ZK8v1BSgjmnLBghsKeV+E="

# ============================================
# DATABASE
# ============================================
# SQLite database (default for development)
# Format: file:./dev.db
# For PostgreSQL: postgresql://user:password@localhost:5432/lastgenie
DATABASE_URL="file:./dev.db"

# ============================================
# SERVER CONFIGURATION
# ============================================
# Port for the Express API server
PORT=3001
# Frontend URL for CORS configuration
CLIENT_URL="http://localhost:3000"

# ============================================
# EMAIL CONFIGURATION
# ============================================
# SMTP settings for sending emails
# For development, emails will be logged to console
# For production, configure with your email provider (Gmail, SendGrid, AWS SES, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="noreply@lastgenie.com"

# ============================================
# PAYMENT PROCESSING (Stripe)
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys
# Use test keys for development
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"
# Webhook secret for verifying Stripe webhooks
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================
# AGE VERIFICATION
# ============================================
# Minimum age requirement for purchases (default: 18)
MINIMUM_AGE=18

# ============================================
# SHIPPING (Shippo)
# ============================================
# Get from: https://apps.goshippo.com/api/
# Required for shipping rate calculations
SHIPPO_API_TOKEN="shippo_test_your_shippo_api_token_here"

# ============================================
# ADDRESS VALIDATION (USPS)
# ============================================
# Get from: https://developers.usps.com/
# Free address validation service - register an app to get credentials
# Use testing endpoint for development, production endpoint for live
USPS_CLIENT_ID="your_usps_client_id"
USPS_CLIENT_SECRET="your_usps_client_secret"
USPS_BASE_URL="https://apis-tem.usps.com"  # Use apis-tem.usps.com for testing, apis.usps.com for production

# ============================================
# FULFILLMENT (ShipStation) - Optional
# ============================================
# For order fulfillment automation
SHIPSTATION_AUTH_USER="your_shipstation_user"
SHIPSTATION_AUTH_PASS="your_shipstation_pass"

# ============================================
# MARKETING (Klaviyo) - Optional
# ============================================
# For email marketing and customer data sync
KLAVIYO_API_KEY="pk_your_klaviyo_api_key_here"

# ============================================
# SOCIAL MEDIA PIXELS - Optional
# ============================================
# For tracking and analytics
META_PIXEL_ID="your_meta_pixel_id"
META_ACCESS_TOKEN="your_meta_access_token"
TIKTOK_PIXEL_ID="your_tiktok_pixel_id"
TIKTOK_ACCESS_TOKEN="your_tiktok_access_token"